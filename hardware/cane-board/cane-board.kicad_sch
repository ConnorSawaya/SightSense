	)
	(text "Motor driver, current limit and watchdog"
		(exclude_from_sim no)
		(at 233.68 25.4 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "38251076-4505-50cd-b88c-43f64f23ebd8")
	)
	(text "Battery in: fuse and reverse-plug protection"
		(exclude_from_sim no)
		(at 15.24 25.4 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "521ce898-51fe-52c1-8ce7-d6d2e11d6473")
	)
	(text "Processor: ESP32-S3"
		(exclude_from_sim no)
		(at 15.24 195.58 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "684d60e5-c858-53df-8dbe-69c20345e72c")
	)
	(text "Motor supply and kill switch"
		(exclude_from_sim no)
		(at 129.54 25.4 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "769d6a4a-4082-5015-96f1-420ab21d0ba9")
	)
	(text "3.3 V"
		(exclude_from_sim no)
		(at 154.94 111.76 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "85775d1f-ae92-5616-83d3-024913f3e177")
	)
	(text "3S lithium-ion pack, 9.0 to 12.6 V, on its barrel plug (centre positive). Q1 and Q4 stay off\nif the plug is wired the other way round. R34 and R1 hold their gates at a third of the battery."
		(exclude_from_sim no)
		(at 15.24 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "904375b0-f122-5d10-b1d6-30c66e27c390")
	)
	(text "Switch closed (or a jumper on J3): motor supply on, Q2's gate at 0.43 of the battery.\nOpen, unplugged or a broken wire: off within about 2 ms. C26 keeps Q2 off at plug-in."
		(exclude_from_sim no)
		(at 129.54 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "92afef7f-566a-57c7-9757-14d8cb7276e2")
	)
	(text "Current limit = 3.3 V / R5 / 1000 uA/A: 1.5k gives 2.2 A. All resistors 1%."
		(exclude_from_sim no)
		(at 314.96 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a09e30ce-eed5-59f0-b86e-77ec3ccfaab0")
	)
	(text "5 V out for the phone (not fitted)"
		(exclude_from_sim no)
		(at 243.84 111.76 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "cad3e1d9-7f06-5deb-af08-6b017a0f3fdd")
	)
	(text "A sealed switching module (YLPTEC K7805-1000R3: 8-36 V in, 5 V 1 A out, pins 1 in, 2 ground, 3 out).\nThe converter's layout is inside it, so the board's layout cannot spoil it."
		(exclude_from_sim no)
		(at 15.24 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ce435f57-c996-5337-bf33-feea6a8a2281")
	)
	(text "IO3, IO45, IO46 are boot-mode pins: left open. IO35 to IO37 are left open so a module with more memory also fits.\nDividers 1M/100k: 2.2 V at the 24.4 V clamp, and only microamps into the processor when it is off."
		(exclude_from_sim no)
		(at 114.3 281.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cf53e005-1e5b-5d76-abfe-14072fba6f0d")
	)
	(text "12 V to 5 V: ready-made module"
		(exclude_from_sim no)
		(at 15.24 111.76 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "f274b562-c4d8-56c7-92b0-ab56dc1f9744")
	)
