# Copy this to the SD card's boot partition as sightsense.env.
# On the Pi that is /boot/firmware/sightsense.env. Delete it to stop the
# controller starting by itself.

# The GX10's address and its Pi port.
SIGHTSENSE_GX10=100.108.5.67:8766

# The motor directly drives the mecanum wheel. LEFT and RIGHT spin opposite
# ways; CENTER, STOP and FREE switch off. No homing or position switches.
# Add --swap if the physical left/right effect is reversed.
# Duty remains capped at 25%; 120 is the nameplate RPM, not measured RPM.
SIGHTSENSE_CANE_ARGS=--wheel-drive --duty 0.25 --rated-rpm 120
