# Copy this to the SD card's boot partition as sightsense.env.
# On the Pi that is /boot/firmware/sightsense.env. Delete it to stop the
# controller starting by itself.

# The GX10's address and its Pi port.
SIGHTSENSE_GX10=169.233.72.156:8766

# Extra options for cane.py. Use --open-loop while no limit switches are
# fitted, and put the wheel at centre by hand before the Pi starts.
SIGHTSENSE_CANE_ARGS=--open-loop
